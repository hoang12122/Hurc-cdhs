{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-init",
    "paths": {
      "@prisma/client/*": ["./.prisma-runtime/*"]
    }
  },
  "include": [
    "src/scripts/container-init.ts",
    "src/scripts/migrate-json-to-pg.ts"
  ]
}
