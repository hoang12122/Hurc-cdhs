{
  "root": true,
  "extends": [
    "next/core-web-vitals"
  ],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "dist-init/**",
    ".prisma-runtime/**",
    ".build-logs/**",
    "public/**",
    "docs/**",
    "*.config.js",
    "*.config.cjs",
    "*.config.mjs"
  ],
  "rules": {
    "@next/next/no-img-element": "off",
    "react-hooks/exhaustive-deps": "off"
  }
}
