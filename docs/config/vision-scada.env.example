# Vision Training — Phase 3 or 4
VISION_TRAINER_IMAGE=replace-with-vision-trainer-version-or-digest
VISION_TRAINER_URL=http://vision-trainer:8090
VISION_TRAINER_TOKEN=replace-with-at-least-24-random-characters
VISION_TRAINING_ENABLED=false
VISION_MAX_UPLOAD_BYTES=12582912
VISION_MIN_APPROVED_PER_CLASS=20
VISION_MAX_EPOCHS=200
VISION_ALLOWED_BASE_MODELS=yolo11n.pt,yolo11s.pt,yolo11m.pt

# Set true only after dataset review, leakage check and approved evaluation evidence.
VISION_DATASET_REVIEW_APPROVED=false
VISION_MODEL_VALIDATION_APPROVED=false

# Read-only SCADA/F-SCADA Gateway — Phase 1 to 4
SCADA_GATEWAY_IMAGE=replace-with-scada-gateway-version-or-digest
SCADA_GATEWAY_URL=http://scada-gateway:8091
SCADA_GATEWAY_ENABLED=false
SCADA_CONFIG_FILE=./infra/scada-gateway/config.example.yaml
SCADA_MAX_SOURCES=20
SCADA_MAX_POINTS_PER_SOURCE=500

# Set true only after network/security review and read-only verification.
SCADA_READ_ONLY_VALIDATED=false
SCADA_SECURITY_REVIEW_APPROVED=false

# Vendor/F-SCADA read token referenced by ${F_SCADA_READ_TOKEN} in scada.yaml.
# Store the real value in the deployment secret manager, not in Git.
F_SCADA_READ_TOKEN=
