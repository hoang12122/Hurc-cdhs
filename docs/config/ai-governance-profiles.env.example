# AI governance runtime profile
# LOW: low resource usage; STANDARD: former CURRENT values; HIGH: higher capacity after load testing.
AI_RUNTIME_PROFILE=STANDARD

# AI assurance profile
# LOW: development only; STANDARD: normal operations; HIGH: safety/operations strict mode.
AI_ASSURANCE_PROFILE=STANDARD

# LOW assurance is blocked in production unless this explicit exception is enabled.
AI_ALLOW_LOW_ASSURANCE_IN_PRODUCTION=false

# Governed continuous learning.
# Learning is feedback-driven and human-approved. These settings never enable autonomous code changes.
AI_CONTINUOUS_LEARNING_ENABLED=true
AI_LEARNING_WINDOW_DAYS=30
AI_LEARNING_MIN_CONFIDENCE=0.80
AI_LEARNING_MIN_REINFORCEMENTS=3

# The following capabilities are intentionally unsupported and remain false in code:
# AI_LEARNING_AUTO_PROMOTE=false
# AI_AUTONOMOUS_CODE_CHANGES=false
# AI_OPERATIONAL_WRITE_ACCESS=false

# Optional bounded overrides. Invalid values are clamped to hard safety limits.
# AI_EXECUTION_TIMEOUT_MS=120000
# AI_MAX_CONCURRENT_PER_NAMESPACE=3
# AI_QUEUE_TIMEOUT_MS=15000
# AI_FAILURE_THRESHOLD=5
# AI_COOLDOWN_MS=60000
# AI_MEMORY_DEFAULT_CONFIDENCE=0.68
# AI_MEMORY_HUMAN_APPROVED_MIN=0.95
# AI_MEMORY_PROVISIONAL_THRESHOLD=0.65
# AI_MEMORY_MIN_CONFIDENCE=0.65
# AI_MEMORY_INCLUDE_PROVISIONAL=true
# AI_MEMORY_RETRIEVAL_LIMIT=5
# AI_MEMORY_RELEVANCE_THRESHOLD=0.20
# AI_DATA_QUARANTINE_TRUST_BELOW=40
# AI_DATA_REVIEW_QUALITY_BELOW=60
# AI_DATA_REVIEW_TRUST_BELOW=65
# AI_DATA_REVIEW_ISSUE_COUNT=4
# AI_DATA_CONTEXT_MAX_CHARS=24000
# AI_AGENT_TOOL_READ_ENABLED=true
# AI_AGENT_MEMORY_CANDIDATES_ENABLED=true
