# HURC converged platform runtime template
# Copy selected values into the deployment secret/environment store.
# Do not commit real passwords, private keys or tokens.

# Deployment mode: development | uat | production
PLATFORM_DEPLOYMENT_MODE=development

# 0 = disabled; 1 = IoT; 2 = Big Data; 3 = MLOps; 4 = Evidence Ledger
DATA_PLATFORM_PHASE=0

# Runtime feature switches. A feature cannot be enabled before its phase.
IOT_RUNTIME_ENABLED=true
EVENT_BACKBONE_ENABLED=true
LAKEHOUSE_RUNTIME_ENABLED=true
MLOPS_RUNTIME_ENABLED=true
EVIDENCE_LEDGER_ENABLED=true

# Phase 1 — MQTT and TimescaleDB
MQTT_IMAGE=eclipse-mosquitto:2.0.20
MQTT_HOST_PORT=1883
MQTT_TOPIC=hurc/+/+/+/+/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_MAX_PAYLOAD_BYTES=262144
MQTT_ALLOW_ANONYMOUS=true
IOT_REQUIRE_TLS=false
IOT_DEVICE_IDENTITY_ENFORCED=false

TIMESCALE_IMAGE=timescale/timescaledb-ha:pg18
TIMESCALE_HOST_PORT=5433
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=replace-with-secret
TIMESCALE_DATABASE=hurc_telemetry
TIMESCALE_DATABASE_URL=postgresql://postgres:replace-with-secret@timescaledb:5432/hurc_telemetry

# Phase 2 — Redpanda/Kafka, Outbox, MinIO and ClickHouse
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.1.12
REDPANDA_CONNECT_IMAGE=replace-with-pinned-redpanda-connect-image
KAFKA_BROKERS=redpanda:9092
REDPANDA_REPLICATION_FACTOR=1
KAFKA_HOST_PORT=19092
SCHEMA_REGISTRY_URL=http://redpanda:8081
SCHEMA_REGISTRY_HOST_PORT=18081
REDPANDA_ADMIN_HOST_PORT=19644

OUTBOX_EVENT_TOPIC=ops.domain-events
OUTBOX_DEAD_LETTER_TOPIC=ops.domain-events.dead-letter
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LOCK_TIMEOUT_SECONDS=300
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_MIGRATION_APPLIED=false

MINIO_IMAGE=minio/minio:RELEASE.2025-05-24T17-08-30Z
MINIO_MC_IMAGE=replace-with-pinned-minio-mc-image
MINIO_ROOT_USER=replace-with-user
MINIO_ROOT_PASSWORD=replace-with-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8-alpine
CLICKHOUSE_NODE_COUNT=1
CLICKHOUSE_USER=hurc
CLICKHOUSE_PASSWORD=replace-with-secret
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_HTTP_HOST_PORT=8123

# Phase 3 — MLflow
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.5.1
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_HOST_PORT=5000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MODEL_APPROVAL_WORKFLOW_ENABLED=false

# Phase 4 — Besu and evidence ledger gateway
BESU_IMAGE=hyperledger/besu:25.7.0
BESU_NETWORK=dev
BESU_RPC_URL=http://besu:8545
BESU_RPC_HOST_PORT=8545
BESU_MINER_COINBASE=0x0000000000000000000000000000000000000000

LEDGER_GATEWAY_URL=http://evidence-ledger:8787
LEDGER_GATEWAY_HOST_PORT=8787
LEDGER_GATEWAY_TOKEN=replace-with-at-least-24-random-characters
LEDGER_WRITE_ENABLED=false
LEDGER_SIGNER_MODE=disabled

# local-dev is only for isolated POC and is blocked in production.
LEDGER_PRIVATE_KEY=

# Production uses an external signer/KMS/HSM integration.
PLATFORM_KMS_PROVIDER=
LEDGER_EXTERNAL_SIGNER_URL=
LEDGER_EXTERNAL_SIGNER_TOKEN=

# Cross-cutting hard limits
EVENT_MAX_PAYLOAD_BYTES=524288
INGESTION_RATE_PER_SECOND=100
DEAD_LETTER_RETENTION_DAYS=30
RAW_RETENTION_DAYS=90

# Acceptance evidence. Set true only after approved evidence exists.
PLATFORM_IMAGES_PINNED=false
PLATFORM_BENCHMARK_APPROVED=false
PLATFORM_SECURITY_REVIEW_APPROVED=false
PLATFORM_BACKUP_RESTORE_TESTED=false
PLATFORM_DR_TESTED=false

# Image policy
# Replace every :latest tag with a reviewed version or immutable digest before production.
# Keep image updates behind CI, security scanning and rollback evidence.
