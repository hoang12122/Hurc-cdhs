generator client {
  provider      = "prisma-client-js"
  output        = "../../.prisma-runtime/auth"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

model User {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  password              String?
  role                  String // References Role.id
  status                String // 'active' | 'inactive'
  department            String?
  isVerified            Boolean       @default(false)
  passwordLastChangedAt DateTime?     @default(now())
  permissions           String[]      @default([])
  assignedSubsystems    String[]      @default([])
  avatarUrl             String?
  verificationOtp       String?
  otpExpiry             DateTime?
  twoFactorEnabled      Boolean       @default(false)
  twoFADevices          TwoFADevice[]
  backupCodes           BackupCode[]
  accessTokens          AccessToken[]
  activeSessionId       String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([status])
  @@index([role, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String
  permissions String[] @default([])

  @@map("roles")
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  userName  String
  status    String // 'pending' | 'approved' | 'rejected'
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@map("password_reset_requests")
}

model TwoFADevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'totp' | 'sms' etc.
  name      String
  secret    String
  isDefault Boolean  @default(false)
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("two_fa_devices")
}

model BackupCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("backup_codes")
}

model AccessToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // 'api' | 'icalendar' | 'meeting_ical' | 'oauth' | 'rss'
  name            String
  tokenHash       String    @unique
  calendar        String? // for iCalendar
  project         String? // for iCalendar
  active          Boolean   @default(true)
  lastRefreshedAt DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@map("access_tokens")
}
