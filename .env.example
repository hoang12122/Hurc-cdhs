# HURC-CDHS environment template
# Copy this file to .env for local/CI smoke deployment.
# In production, override every secret value via the deployment platform secret store.

NODE_ENV=production
NEXT_PUBLIC_SETUP_COMPLETE=true

# Required authentication secret. Replace with a long random value in production.
SESSION_SECRET=change-this-to-a-long-random-production-secret

# Password hashing work factor. Benchmark on the production host before increasing.
# Allowed range: 10-15. The application default is 12.
BCRYPT_COST=12

# PostgreSQL database URLs
AUTH_DATABASE_URL=postgresql://postgres:hurc123@postgres:5432/hurc_auth
AI_DATABASE_URL=postgresql://postgres:hurc123@postgres:5432/hurc_ai
METRO_DATABASE_URL=postgresql://postgres:hurc123@postgres:5432/hurc_metro
OPS_DATABASE_URL=postgresql://postgres:hurc123@postgres:5432/hurc_ops
DATABASE_URL=postgresql://postgres:hurc123@postgres:5432/hurc_db

# Supporting services
MONGODB_URI=mongodb://admin:hurc123@mongo:27017/hurc?authSource=admin
REDIS_URL=redis://redis:6379

# Optional observability/admin defaults for local smoke deployment only
DATABASE_USER=postgres
DATABASE_PASSWORD=hurc123
DATABASE_NAME=hurc_db
MONGO_USER=admin
MONGO_PASSWORD=hurc123
GRAFANA_PASSWORD=hurc123
