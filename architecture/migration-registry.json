{
  "schemaVersion": 1,
  "policy": "docs/technical/LEGACY_MODULE_MIGRATION_STRATEGY.md",
  "allowedStates": ["legacy", "isolated", "shadow", "canary", "migrated", "retired"],
  "modules": [
    {
      "id": "example-module",
      "boundedContext": "example",
      "owner": "architecture-team",
      "legacyPath": "src/app/(app)/example-module",
      "targetFrontendPath": "frontend/features/example-module",
      "targetBackendPath": "backend/services/example-module",
      "state": "isolated",
      "publicContract": "backend/contracts/example-module/v1.ts",
      "featureFlag": "exampleModuleBackboneV1",
      "rollbackManifest": "architecture/rollback/example-module.json",
      "characterizationTests": [
        "scripts/test-example-module-migration-contract.mjs",
        "src/components/example-module/use-example-module-workflow.ts"
      ],
      "cutover": {
        "enabled": false,
        "trafficPercent": 0,
        "approvalRequired": true
      },
      "notes": "Pilot isolated behind a published contract. Legacy route remains authoritative; no shadow, canary or production cutover is claimed."
    }
  ]
}
