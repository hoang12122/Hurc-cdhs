{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/guard-install.js",
    "dev": "node scripts/check-local-ai-only.mjs --runtime-only && node scripts/preflight-node.js && npx tsx src/scripts/local-preflight.ts && next dev",
    "build": "node scripts/check-local-ai-only.mjs && node scripts/preflight-node.js && npx tsx src/scripts/build-env-guard.ts && npm run db:verify:prisma-version && npm run db:generate:all && next build",
    "db:verify:prisma-version": "node scripts/check-prisma-version.js",
    "db:generate:all": "prisma generate --schema=prisma/auth/schema.prisma && prisma generate --schema=prisma/ai/schema.prisma && prisma generate --schema=prisma/metro/schema.prisma && prisma generate --schema=prisma/ops/schema.prisma && prisma generate --schema=prisma/schema.prisma",
    "db:validate:all": "npm run db:verify:prisma-version && prisma validate --schema=prisma/auth/schema.prisma && prisma validate --schema=prisma/ai/schema.prisma && prisma validate --schema=prisma/metro/schema.prisma && prisma validate --schema=prisma/ops/schema.prisma && prisma validate --schema=prisma/schema.prisma",
    "import:gis-bim:dry-run": "npx tsx src/scripts/import-gis-bim.ts --dry-run",
    "import:gis-bim:commit": "npx tsx src/scripts/import-gis-bim.ts --commit",
    "start": "node scripts/check-local-ai-only.mjs --runtime-only && next start",
    "lint": "node scripts/run-eslint.js . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "audit:linkage": "node scripts/audit-software-linkage.js",
    "check-updates": "ncu",
    "migrate": "npx tsx src/scripts/migrate-json-to-pg.ts",
    "db:ops:migrate": "npx tsx src/scripts/safe-migrate.ts ops",
    "db:ai:migrate": "npx tsx src/scripts/safe-migrate.ts ai",
    "db:ops:generate": "prisma generate --schema=prisma/ops/schema.prisma",
    "db:ai:generate": "prisma generate --schema=prisma/ai/schema.prisma",
    "db:ops:status": "prisma migrate status --schema=prisma/ops/schema.prisma",
    "db:check:integrity": "npx tsx src/scripts/run-integrity-checks.ts",
    "test:db": "npx tsx src/scripts/test-multi-db.ts",
    "test:mock": "npx tsx src/scripts/test-mock-layer.ts",
    "test:integrity": "npx tsx src/scripts/test-cross-db-integrity.ts",
    "test:graph": "npx tsx src/scripts/test-trustgraph-sync.ts",
    "test:ai-governance": "npx tsx src/scripts/test-ai-governance.ts && npx tsx src/scripts/test-secure-rag-hooks.ts && npx tsx src/scripts/test-local-ai-vector-memory.ts",
    "test:ai-profiles": "npx tsx src/scripts/test-ai-profiles.ts",
    "test:continuous-learning": "npx tsx src/scripts/test-continuous-learning.ts",
    "test:platform-profiles": "npx tsx src/scripts/test-converged-platform.ts",
    "test:digital-twin-health": "npx tsx src/scripts/test-digital-twin-health.ts",
    "test:platform-readiness": "npx tsx src/scripts/test-platform-production-readiness.ts",
    "test:secure-rag-hooks": "npx tsx src/scripts/test-secure-rag-hooks.ts",
    "test:local-ai-vector-memory": "npx tsx src/scripts/test-local-ai-vector-memory.ts",
    "test:model-registry": "node scripts/test-model-registry.mjs",
    "test:governed-memory": "node scripts/test-governed-memory.mjs",
    "test:phase-integration": "node scripts/test-phase-integration.mjs",
    "model-registry:sign": "node scripts/model-registry-sign.mjs",
    "model-registry:verify": "node scripts/model-registry-verify.mjs",
    "test:production-resilience": "node scripts/check-production-resilience-baseline.mjs",
    "test:architecture-backbone": "node scripts/check-architecture-backbone.mjs",
    "test:safe-module-migration": "node scripts/check-safe-module-migration.mjs",
    "test:example-module-migration": "node scripts/test-example-module-migration-contract.mjs",
    "security:local-ai-only": "node scripts/check-local-ai-only.mjs",
    "test:guard": "node scripts/test-guard.js",
    "platform:config": "node scripts/platform-compose.mjs config",
    "platform:phase1:up": "node scripts/platform-compose.mjs up 1",
    "platform:phase2:up": "node scripts/platform-compose.mjs up 2",
    "platform:phase3:up": "node scripts/platform-compose.mjs up 3",
    "platform:phase4:up": "node scripts/platform-compose.mjs up 4",
    "platform:status": "node scripts/check-converged-platform.mjs",
    "platform:ps": "node scripts/platform-compose.mjs ps",
    "platform:logs": "node scripts/platform-compose.mjs logs",
    "platform:down": "node scripts/platform-compose.mjs down",
    "platform:production:check": "npx tsx src/scripts/check-platform-production-readiness.ts",
    "platform:production:attest": "npx tsx src/scripts/emit-platform-production-attestation.ts",
    "security:rotate-compromised-admins": "npx tsx src/scripts/rotate-compromised-admin-credentials.ts",
    "db:dashboard": "npx tsx src/scripts/generate-integrity-dashboard.ts"
  },
  "dependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.0",
