generator client {
  provider      = "prisma-client-js"
  output        = "../../.prisma-runtime/metro"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("METRO_DATABASE_URL")
}

model Asset {
  id           String   @id @default(uuid())
  code         String   @unique // e.g., 'STN-L1-A'
  name         String
  subsystem    String   // 'Signaling', 'Power', 'Track', etc.
  stationId    String?  @map("station_id")
  systemId     String?  @map("system_id")
  parentId     String?
  parent       Asset?   @relation("AssetHierarchy", fields: [parentId], references: [id])
  children     Asset[]  @relation("AssetHierarchy")
  criticality  String   @default("Medium") // 'High', 'Medium', 'Low'
  specification Json?   // Dynamic technical specs
  spatialLinks AssetSpatialLink[]
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime @updatedAt

  @@index([subsystem])
  @@index([stationId])
  @@index([systemId])
  @@index([parentId])
  @@index([criticality])
  @@map("metro_assets")
}

model TelemetryReading {
  id        String   @id @default(uuid())
  assetId   String
  metric    String   // e.g., 'Temperature', 'Voltage', 'Status'
  value     Float
  unit      String?
  timestamp DateTime @default(now())

  @@index([assetId, timestamp])
  @@index([assetId, metric])
  @@map("metro_telemetry")
}

model SnmpConfig {
  id        String   @id @default(uuid())
  assetId   String   @unique
  ip        String
  community String   @default("public")
  oid       String   // The OID to poll for this asset
  metricName String  // The name of the metric (e.g. 'UPS_Voltage')
  intervalSeconds Int @default(60)
  lastPolled DateTime?

  @@map("metro_snmp_configs")
}

model RailLine {
  id          String   @id @default(uuid())
  code        String   @unique // M1, M2, M3...
  name        String
  color       String
  status      String   @default("planned") // operating | construction | planned | proposed
  terminalA   String?  @map("terminal_a")
  terminalB   String?  @map("terminal_b")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  stations    RailLineStation[]
  responsibilities ResponsibilityAssignment[]
  gisLayers   GisLayer[]
  bimModels   BimModel[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([status])
  @@index([sortOrder])
  @@map("metro_rail_lines")
}

model RailStation {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  stationType          String   @default("standard") @map("station_type") // standard | interchange | terminal | depot | future
  district             String?
  locationDescription  String?  @map("location_description")
  mapX                 Float?   @map("map_x")
  mapY                 Float?   @map("map_y")
  longitude            Float?
  latitude             Float?
  elevationMeters      Float?   @map("elevation_meters")
  isInterchange        Boolean  @default(false) @map("is_interchange")
  status               String   @default("planned") // operating | construction | planned | proposed
  lines                RailLineStation[]
  responsibilities     ResponsibilityAssignment[]
  gisLayers            GisLayer[]
  bimModels            BimModel[]
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  @@index([stationType])
  @@index([isInterchange])
  @@index([status])
  @@index([longitude, latitude])
  @@map("metro_rail_stations")
}

model RailLineStation {
  id                  String   @id @default(uuid())
  lineId              String   @map("line_id")
  stationId           String   @map("station_id")
  sequence            Int
  distanceFromStartKm Float?   @map("distance_from_start_km")
  isTerminal          Boolean  @default(false) @map("is_terminal")
  isTransferPoint     Boolean  @default(false) @map("is_transfer_point")
  line                RailLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station             RailStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([lineId, stationId])
  @@index([lineId, sequence])
  @@index([stationId])
  @@map("metro_rail_line_stations")
}

model ResponsibilityAssignment {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id") // auth.users.id; kept as string because auth DB is separated
  userNameSnapshot   String?  @map("user_name_snapshot")
  responsibilityType String   @default("owner") @map("responsibility_type") // owner | maintainer | reviewer | approver | viewer
  lineId             String?  @map("line_id")
  stationId          String?  @map("station_id")
  systemId           String?  @map("system_id")
  subsystem          String?
  assetId            String?  @map("asset_id")
  validFrom          DateTime @default(now()) @map("valid_from")
  validTo            DateTime? @map("valid_to")
  active             Boolean  @default(true)
  note               String?
  line               RailLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  station            RailStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([lineId])
  @@index([stationId])
  @@index([systemId])
  @@index([subsystem])
  @@index([assetId])
  @@index([active])
  @@map("metro_responsibility_assignments")
}

model GisLayer {
  id             String   @id @default(uuid())
  name           String
  layerType      String   @map("layer_type") // station | alignment | tunnel | viaduct | utility | risk_zone | asset
  sourceType     String   @default("geojson") @map("source_type") // geojson | wms | wmts | arcgis | postgis
  sourceUrl      String?  @map("source_url")
  crs            String   @default("EPSG:4326")
  lineId         String?  @map("line_id")
  stationId      String?  @map("station_id")
  visible        Boolean  @default(true)
  style          Json?
  metadata       Json?
  line           RailLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  station        RailStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  features       GisFeature[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([layerType])
  @@index([sourceType])
  @@index([lineId])
  @@index([stationId])
  @@index([visible])
  @@map("metro_gis_layers")
}

model GisFeature {
  id             String   @id @default(uuid())
  layerId        String   @map("layer_id")
  externalId     String?  @map("external_id")
  name           String?
  geometryType   String   @map("geometry_type") // Point | LineString | Polygon | MultiLineString | MultiPolygon
  geometry       Json
  properties     Json?
  assetId        String?  @map("asset_id")
  stationId      String?  @map("station_id")
  lineId         String?  @map("line_id")
  layer          GisLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  spatialLinks   AssetSpatialLink[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([layerId])
  @@index([externalId])
  @@index([assetId])
  @@index([stationId])
  @@index([lineId])
  @@map("metro_gis_features")
}

model BimModel {
  id             String   @id @default(uuid())
  name           String
  modelType      String   @default("ifc") @map("model_type") // ifc | gltf | glb | revit | point_cloud
  sourceUrl      String?  @map("source_url")
  version        String?
  discipline     String?  // architecture | structure | mep | railway_system | civil
  coordinateSystem String? @map("coordinate_system")
  lineId         String?  @map("line_id")
  stationId      String?  @map("station_id")
  status         String   @default("draft") // draft | approved | as_built | archived
  metadata       Json?
  line           RailLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  station        RailStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  elements       BimElement[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([modelType])
  @@index([discipline])
  @@index([lineId])
  @@index([stationId])
  @@index([status])
  @@map("metro_bim_models")
}

model BimElement {
  id             String   @id @default(uuid())
  modelId        String   @map("model_id")
  globalId       String?  @map("global_id") // IFC GlobalId / Revit UniqueId / external element id
  name           String?
  elementType    String?  @map("element_type") // door | wall | slab | equipment | cable_tray | track | platform_screen_door
  levelName      String?  @map("level_name")
  assetId        String?  @map("asset_id")
  properties     Json?
  boundingBox    Json?    @map("bounding_box")
  model          BimModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  spatialLinks   AssetSpatialLink[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([modelId])
  @@index([globalId])
  @@index([elementType])
  @@index([assetId])
  @@map("metro_bim_elements")
}

model AssetSpatialLink {
  id             String   @id @default(uuid())
  assetId        String   @map("asset_id")
  gisFeatureId   String?  @map("gis_feature_id")
  bimElementId   String?  @map("bim_element_id")
  linkType       String   @default("reference") @map("link_type") // reference | installed_at | monitored_by | located_in | digital_twin
  confidence     Float    @default(1)
  note           String?
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  gisFeature     GisFeature? @relation(fields: [gisFeatureId], references: [id], onDelete: SetNull)
  bimElement     BimElement? @relation(fields: [bimElementId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([gisFeatureId])
  @@index([bimElementId])
  @@index([linkType])
  @@map("metro_asset_spatial_links")
}
